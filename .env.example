# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- Database -------------------------------------------------------------
# SQLite needs no setup (good for a first run):
ADAPTIVE_IDS_DATABASE_URL=sqlite:///./var/adaptive_ids.db
# PostgreSQL (target), e.g. via `docker compose up -d postgres`:
# ADAPTIVE_IDS_DB_PASSWORD=change-me-local-only
# ADAPTIVE_IDS_DATABASE_URL=postgresql+psycopg://adaptive_ids:change-me-local-only@127.0.0.1:5432/adaptive_ids

# --- Storage and limits -----------------------------------------------------
ADAPTIVE_IDS_STORAGE_DIR=./var/storage
ADAPTIVE_IDS_RUNS_DIR=./experiments/runs
ADAPTIVE_IDS_MAX_UPLOAD_MB=200
ADAPTIVE_IDS_MAX_IMPORT_ROWS=1000000
ADAPTIVE_IDS_SESSION_HOURS=12
# Serve the built web UI from the API (after `npm run build` in apps/web):
# ADAPTIVE_IDS_WEB_DIST=apps/web/dist
# Comma-separated origins allowed to call the API from a browser (the Phase 4 web app).
ADAPTIVE_IDS_CORS_ORIGINS=http://localhost:5173

# --- Research recovery (used in docs/reproducing-the-baseline.md commands) --
ADAPTIVE_IDS_ORIGINAL_PROJECT=D:\path\to\MSc_Research_IDS
ADAPTIVE_IDS_DATA_DIR=D:\AdaptiveIDS\data
