# Copy to .env and adjust. No secrets are required for Milestone 1.
# These are not read by the code yet; the commands in docs/reproducing-the-baseline.md use them.
# Location of the ORIGINAL MSc project (read-only; used by `adaptive-ids inventory`).
ADAPTIVE_IDS_ORIGINAL_PROJECT=D:\path\to\MSc_Research_IDS
# Where large datasets live (kept outside git).
ADAPTIVE_IDS_DATA_DIR=D:\AdaptiveIDS\data
