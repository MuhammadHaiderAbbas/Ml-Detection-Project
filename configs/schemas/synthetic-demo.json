{
  "name": "synthetic-flows-demo",
  "version": "1.1.0",
  "status": "verified",
  "notes": "Schema for the SYNTHETIC demonstration dataset produced by `adaptive-ids make-synthetic`. Not a research schema.",
  "label_column": "Label",
  "benign_label": "Benign",
  "timestamp_column": "Timestamp",
  "event_id_column": "Flow ID",
  "excluded_columns": [
    "Src IP",
    "Dst IP"
  ],
  "context_columns": [
    "Src IP",
    "Dst IP",
    "Dst Port"
  ],
  "source_column": "Src IP",
  "destination_column": "Dst IP",
  "missing_value_policy": "reject_row",
  "infinite_value_policy": "reject_row",
  "features": [
    {
      "name": "Dst Port",
      "dtype": "int",
      "min": 0,
      "max": 65535
    },
    {
      "name": "Protocol",
      "dtype": "int",
      "min": 0
    },
    {
      "name": "Flow Duration",
      "dtype": "int",
      "min": 0
    },
    {
      "name": "Tot Fwd Pkts",
      "dtype": "int",
      "min": 0
    },
    {
      "name": "Tot Bwd Pkts",
      "dtype": "int",
      "min": 0
    },
    {
      "name": "TotLen Fwd Pkts",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "TotLen Bwd Pkts",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "Fwd Pkt Len Mean",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "Bwd Pkt Len Mean",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "Flow Byts/s",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "Flow Pkts/s",
      "dtype": "float",
      "min": 0
    },
    {
      "name": "SYN Flag Cnt",
      "dtype": "int",
      "min": 0
    }
  ],
  "metadata": {
    "provenance": "synthetic_demo"
  }
}
