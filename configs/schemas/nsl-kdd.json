{
  "name": "nsl-kdd",
  "version": "1.0.0",
  "status": "verified",
  "notes": "NSL-KDD (KDDTrain+/KDDTest+) as written by `adaptive-ids prepare-nsl-kdd`. Features: all 38 numeric traffic columns. The per-record difficulty level is excluded: it is annotation metadata, and the MSc notebook's use of it as a feature inflated its results (docs/msc-notebook-review.md). protocol_type, service and flag are kept as context only. num_outbound_cmds is constant in NSL-KDD but kept for completeness. row_order_time is a synthetic ordering timestamp (NSL-KDD has no time information); do not read it as real time.",
  "label_column": "label",
  "benign_label": "normal",
  "timestamp_column": "row_order_time",
  "event_id_column": "record_id",
  "excluded_columns": [
    "difficulty",
    "protocol_type",
    "service",
    "flag"
  ],
  "context_columns": [
    "protocol_type",
    "service",
    "flag"
  ],
  "missing_value_policy": "reject_row",
  "infinite_value_policy": "reject_row",
  "features": [
